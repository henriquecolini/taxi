# ─── Required ────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Random secret, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your Google account. It is the only account that can edit anything.
OWNER_EMAIL=you@example.com

# ─── Optional ────────────────────────────────────────────────────────────────

# SQLite file. Defaults to ./data/taxi.db locally and /data/taxi.db in the
# Docker image. Don't set this on Coolify: a relative path would put the
# database outside the persistent volume.
# DATABASE_PATH=./data/taxi.db

# Timezone used for days, weeks and invoice dates.
TIMEZONE=America/Sao_Paulo

# GitLab integration: a personal access token with the `read_api` scope.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# Only count commits by these authors (comma-separated). Empty = everyone.
GITLAB_AUTHOR_EMAILS=

# AI summaries (https://console.anthropic.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
